# Route-map entries. Identity is (name, seq); the action is an ordinary value on the
# header line, so permit -> deny is an edit rather than a delete + add.

type action = "permit" | "deny"
# An AS to prepend, or the literal `auto`: alternatives are tried in order.
type prependItem = asn | "auto"

model RouteMapEntry
  name: key string
  action: action
  seq: key int
  description: phrase?
  matchPrefixLists: names?
  matchAcl: string?
  matchCommunity: string?
  matchAsPath: string?
  setLocalPref: int?
  setMetric: int?
  setCommunity: names?
  prependAsPath: list(prependItem)?

template
  route-map {{ name }} {{ action }} {{ seq }}
    description {{ description }}
    match ip address prefix-list {{ matchPrefixLists }}
    match ip address {{ matchAcl }}
    match community {{ matchCommunity }}
    match as-path {{ matchAsPath }}
    set local-preference {{ setLocalPref }}
    set metric {{ setMetric }}
    set community {{ setCommunity }}
    set as-path prepend {{ prependAsPath }}
