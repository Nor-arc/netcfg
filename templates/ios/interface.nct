type vlanId = /[1-9][0-9]{0,3}/

model Vlan
  id: key vlanId
  name: string?

template Vlan
  vlan {{ id }}
   name {{ name }}

model Interface
  name: key string
  description: phrase?
  address: cidr?
  mtu: int(576..9216) = 1500
  accessVlan: vlanId?
  shutdown: flag

template Interface
  interface {{ name }}
   description {{ description }}
   ip address {{ address }}
   mtu {{ mtu }}
   switchport access vlan {{ accessVlan }}
   shutdown [[ shutdown ]]
   no shutdown [[ shutdown ]]
   @ignore ip address * * secondary

model StaticRoute
  prefix: key cidr
  nextHop: key ipv4

template StaticRoute
  ip route {{ prefix }} {{ nextHop }}

type aclAction = "permit" | "deny"

# One access-control entry. It has no key: its identity is its position in the list.
model AclEntry
  action: aclAction
  match: phrase           # protocol, source, destination and options as written

template AclEntry
  {{ action }} {{ match }}

model Acl
  name: key string
  entries: [AclEntry] ordered

template Acl
  ip access-list extended {{ name }}
   << entries >>
   @ignore remark

model Device
  hostname: string
  vlans: [Vlan]
  interfaces: [Interface]
  routes: [StaticRoute]
  acls: [Acl]
  bgp: IosBgp?

template Device
  hostname {{ hostname }}
  << vlans >>
  << interfaces >>
  << routes >>
  << acls >>
  << bgp >>
